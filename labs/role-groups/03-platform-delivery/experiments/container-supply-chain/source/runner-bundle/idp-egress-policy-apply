#!/usr/bin/env bash
set -euo pipefail

[[ $(id -u) -eq 0 ]] || exit 77
proxy_uid=$(id -u proxy)
mapfile -t resolvers < <(
  { awk '/^nameserver / {print $2}' /etc/resolv.conf; resolvectl dns 2>/dev/null | grep -Eo '([0-9]{1,3}\.){3}[0-9]{1,3}' || true; } |
    grep -Ev '^(127\.|0\.0\.0\.0$)' | sort -u
)
[[ ${#resolvers[@]} -gt 0 ]] || { echo "no external DNS resolver found" >&2; exit 69; }

iptables -w -N IDP_EGRESS 2>/dev/null || true
iptables -w -F IDP_EGRESS
iptables -w -C OUTPUT -j IDP_EGRESS 2>/dev/null || iptables -w -I OUTPUT 1 -j IDP_EGRESS
iptables -w -A IDP_EGRESS -o lo -j ACCEPT
iptables -w -A IDP_EGRESS -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
for resolver in "${resolvers[@]}"; do
  iptables -w -A IDP_EGRESS -d "$resolver" -p udp --dport 53 -j ACCEPT
  iptables -w -A IDP_EGRESS -d "$resolver" -p tcp --dport 53 -j ACCEPT
done
iptables -w -A IDP_EGRESS -m owner --uid-owner "$proxy_uid" -p tcp --dport 443 -j ACCEPT
iptables -w -A IDP_EGRESS -p udp --dport 123 -j ACCEPT
iptables -w -A IDP_EGRESS -d 10.0.0.0/8 -p tcp -m multiport --dports 443,6443 -j REJECT
iptables -w -A IDP_EGRESS -d 172.16.0.0/12 -p tcp -m multiport --dports 443,6443 -j REJECT
iptables -w -A IDP_EGRESS -d 192.168.0.0/16 -p tcp -m multiport --dports 443,6443 -j REJECT
iptables -w -A IDP_EGRESS -j REJECT
iptables -w -P OUTPUT DROP

iptables -w -N IDP_DOCKER_EGRESS 2>/dev/null || true
iptables -w -F IDP_DOCKER_EGRESS
iptables -w -C DOCKER-USER -j IDP_DOCKER_EGRESS 2>/dev/null || iptables -w -I DOCKER-USER 1 -j IDP_DOCKER_EGRESS
iptables -w -A IDP_DOCKER_EGRESS -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
iptables -w -A IDP_DOCKER_EGRESS -d 172.17.0.1/32 -p tcp --dport 3128 -j ACCEPT
iptables -w -A IDP_DOCKER_EGRESS -j REJECT

iptables -w -C INPUT -i docker0 -s 172.17.0.0/16 -p tcp --dport 3128 -j ACCEPT 2>/dev/null || \
  iptables -w -I INPUT 1 -i docker0 -s 172.17.0.0/16 -p tcp --dport 3128 -j ACCEPT
