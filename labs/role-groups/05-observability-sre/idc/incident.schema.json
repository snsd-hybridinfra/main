{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IDC Network Incident Report",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source": {
      "enum": [ "synthetic-fixture", "live-exporter-and-frr", "live-exporter-and-frr-loki" ]
    },
    "from": {
      "type": "string",
      "format": "date-time"
    },
    "to": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_window_s": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "recent_change_window_s": {
      "const": 300
    },
    "incidents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/incident"
      }
    }
  },
  "required": [ "schema_version", "source", "from", "to", "correlation_window_s", "recent_change_window_s", "incidents" ],
  "additionalProperties": false,
  "$defs": {
    "endpoint": {
      "type": "object",
      "properties": {
        "node": {
          "enum": [ "spine1", "spine2", "leaf1", "leaf2", "host1", "host2" ]
        },
        "interface": {
          "type": "string",
          "pattern": "^eth[1-3]$"
        }
      },
      "required": [ "node", "interface" ],
      "additionalProperties": false
    },
    "event": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "event_id": {
              "type": "string",
              "pattern": "^evt-[a-f0-9]{20}$"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "node": {
              "enum": [ "spine1", "spine2", "leaf1", "leaf2", "host1", "host2" ]
            },
            "link_id": {
              "enum": [ "U1", "U2", "U3", "U4", "H1", "H2" ]
            },
            "kind": {
              "enum": [ "interface_down", "interface_up" ]
            },
            "source": {
              "const": "exporter"
            },
            "interface": {
              "type": "string",
              "pattern": "^eth[1-3]$"
            }
          },
          "required": [ "event_id", "timestamp", "node", "link_id", "kind", "source", "interface" ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event_id": {
              "type": "string",
              "pattern": "^evt-[a-f0-9]{20}$"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "node": {
              "enum": [ "spine1", "spine2", "leaf1", "leaf2", "host1", "host2" ]
            },
            "link_id": {
              "enum": [ "U1", "U2", "U3", "U4", "H1", "H2" ]
            },
            "kind": {
              "enum": [ "bgp_down", "bgp_up" ]
            },
            "source": {
              "enum": [ "exporter", "frr_file", "loki" ]
            },
            "peer": {
              "type": "string",
              "format": "ipv4"
            },
            "family": {
              "enum": [ "ipv4", "evpn" ]
            }
          },
          "required": [ "event_id", "timestamp", "node", "link_id", "kind", "source", "peer", "family" ],
          "additionalProperties": false
        }
      ]
    },
    "change": {
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "event": {
          "enum": [ "change_issued", "change_applied", "change_checked", "restore_applied" ]
        },
        "run": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "node": {
          "enum": [ "spine1", "spine2", "leaf1", "leaf2", "host1", "host2" ]
        },
        "candidate": {
          "enum": [ "description", "harmless", "break-vtep" ]
        },
        "interface": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^eth[1-3]$"
            },
            {
              "type": "null"
            }
          ]
        },
        "seconds_before": {
          "type": "number",
          "minimum": 0,
          "maximum": 300
        },
        "relation": {
          "const": "temporal_and_scope_only"
        }
      },
      "required": [ "timestamp", "event", "run", "node", "candidate", "interface", "seconds_before", "relation" ],
      "additionalProperties": false
    },
    "cause": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [ "link_failure_suspected", "undetermined" ]
        },
        "confidence": {
          "enum": [ "suspected", "uncertain" ]
        },
        "basis": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^evt-[a-f0-9]{20}$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [ "kind", "confidence", "basis" ],
      "additionalProperties": false
    },
    "incident": {
      "type": "object",
      "properties": {
        "incident_id": {
          "type": "string",
          "pattern": "^inc-[a-f0-9]{20}$"
        },
        "link_id": {
          "enum": [ "U1", "U2", "U3", "U4", "H1", "H2" ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [ "open", "recovered" ]
        },
        "recovered_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "nodes": {
          "type": "array",
          "items": {
            "enum": [ "spine1", "spine2", "leaf1", "leaf2", "host1", "host2" ]
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/endpoint"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          },
          "minItems": 1
        },
        "cause": {
          "$ref": "#/$defs/cause"
        },
        "recent_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/change"
          }
        }
      },
      "required": [ "incident_id", "link_id", "started_at", "status", "recovered_at", "nodes", "endpoints", "evidence", "cause", "recent_changes" ],
      "additionalProperties": false
    }
  }
}
