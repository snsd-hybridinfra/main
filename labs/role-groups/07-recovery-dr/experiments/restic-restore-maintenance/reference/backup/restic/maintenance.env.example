# Non-secret template. The full-access maintenance repository URL (including REST
# server credentials) is injected separately through RESTIC_REPOSITORY_FILE.
RESTIC_MAINTENANCE_MODE=full-access-approved
RESTIC_CACHE_DIR=/var/cache/iaas-restic
BACKUP_STAGING_ROOT=/var/lib/iaas-backup/staging
BACKUP_HOST_ID=iaas-backup-worker
RESTIC_LOCK_WAIT_SECONDS=1800
RESTIC_KEEP_WITHIN_DAILY=7d
RESTIC_KEEP_WITHIN_WEEKLY=1m
RESTIC_KEEP_WITHIN_MONTHLY=6m
RESTIC_CHECK_SUBSET=5%
