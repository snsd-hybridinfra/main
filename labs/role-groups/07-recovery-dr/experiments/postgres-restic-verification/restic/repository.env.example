# Non-secret template only. The append-only repository URL (including REST server
# credentials) is injected separately through RESTIC_REPOSITORY_FILE.
RESTIC_CACHE_DIR=/var/cache/iaas-restic
BACKUP_STAGING_ROOT=/var/lib/iaas-backup/staging
BACKUP_VERIFY_ROOT=/var/lib/iaas-backup/verification
BACKUP_HOST_ID=iaas-backup-worker
RESTIC_LOCK_WAIT_SECONDS=1800
PGSSLMODE=verify-full
PGSSLROOTCERT=/etc/iaas-backup/postgresql-ca.pem
