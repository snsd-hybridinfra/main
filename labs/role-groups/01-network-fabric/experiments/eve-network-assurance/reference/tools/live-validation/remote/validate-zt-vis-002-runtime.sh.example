#!/usr/bin/env bash
set -euo pipefail

readonly mode="${1:-}"
readonly validation_id="${2:-}"
readonly root=/opt/snsd-zt-vis-002
readonly compose_file="${root}/compose.yaml"
readonly input_file="${root}/input/sanitized/zt-vis-002-live-validation.jsonl"
readonly nginx_site=/etc/nginx/sites-enabled/zt-vis-002
readonly component_ports='3000|3100|12345|9090|9115'

fail() {
  printf 'validation=FAIL\n' >&2
  exit 1
}

require_authorization() {
  [[ "${ZT_VIS_002_LIVE_VALIDATION_AUTHORIZED:-}" == 'YES' ]] || fail
}

validate_id() {
  [[ "${validation_id}" =~ ^P2VIS-[0-9]{8}T[0-9]{6}Z$ ]] || fail
}

configuration_hash() {
  {
    sha256sum "${compose_file}"
    find "${root}/config" -type f -print0 | sort -z | xargs -0 sha256sum
    sha256sum /etc/nginx/sites-available/zt-vis-002
  } | sha256sum | awk '{print $1}'
}

healthy() {
  [[ "$(podman ps -q | wc -l)" -eq 5 ]] || return 1
  curl --fail --silent --max-time 5 http://127.0.0.1:3000/api/health >/dev/null || return 1
  curl --fail --silent --max-time 5 http://127.0.0.1:3100/ready >/dev/null || return 1
  curl --fail --silent --max-time 5 http://127.0.0.1:12345/-/ready >/dev/null || return 1
  curl --fail --silent --max-time 5 http://127.0.0.1:9090/-/ready >/dev/null || return 1
  curl --fail --silent --max-time 5 http://127.0.0.1:9115/-/healthy >/dev/null || return 1
}

wait_healthy() {
  local attempt
  for attempt in $(seq 1 30); do
    if healthy; then
      return 0
    fi
    sleep 2
  done
  return 1
}

assert_mount() {
  local filesystem options
  filesystem="$(findmnt -n -o FSTYPE "${root}")"
  options="$(findmnt -n -o OPTIONS "${root}")"
  [[ "${filesystem}" == ext4 ]] || fail
  grep -q ',nodev,' <<<",${options}," || fail
  grep -q ',nosuid,' <<<",${options}," || fail
}

assert_private_listeners() {
  local listeners configured actual
  listeners="$(ss -lntH | awk '$4 ~ /:(3000|3100|12345|9090|9115)$/ {print $4}')"
  [[ "$(sed '/^$/d' <<<"${listeners}" | wc -l)" -eq 5 ]] || fail
  ! grep -Ev '^127\.0\.0\.1:' <<<"${listeners}" >/dev/null || fail
  ! ss -lntH | awk '$4 ~ /:80$/ {found=1} END {exit !found}' || fail
  configured="$(awk '/^[[:space:]]*listen[[:space:]].*:443[[:space:]]+ssl;/{gsub(/;/,"",$2); print $2; exit}' "${nginx_site}")"
  actual="$(ss -lntH | awk '$4 ~ /:443$/ {print $4}')"
  [[ -n "${configured}" && "${actual}" == "${configured}" ]] || fail
  [[ "${actual}" != '0.0.0.0:443' && "${actual}" != '*:443' ]] || fail
}

assert_permissions() {
  [[ "$(stat -c '%a' "${root}/secrets/grafana_admin_password")" == 600 ]] || fail
  while IFS= read -r path; do
    [[ "$(stat -c '%a' "${path}")" == 644 ]] || fail
  done < <(find "${root}/config" -type f -print | sort)
  [[ "$(stat -c '%a' "${compose_file}")" == 644 ]] || fail
}

assert_images() {
  podman image exists 'docker.io/grafana/grafana@sha256:6ea068891652aa6a65ca9065c26b89de939653803c836426970305c11fd00534'
  podman image exists 'docker.io/grafana/loki@sha256:ac6ad1d73bd4c3c38edc93f91ebc217672fa657c20a5dc7b4b0e25baeec7bebb'
  podman image exists 'docker.io/grafana/alloy@sha256:eb21f4c0858edffcdd1b385910ddeef26f692fc2c282f61baa724fc09d274a17'
  podman image exists 'docker.io/prom/prometheus@sha256:2024d7bdfc559f6254de22d65e62d799eaa8eb818fe5dbeca212d3f200b70890'
  podman image exists 'docker.io/prom/blackbox-exporter@sha256:43027b43fb785b7c5adc53bd3b5dbc1a258270a2e8aff24f477b45c4e38dac68'
}

assert_baseline() {
  assert_mount
  [[ "$(systemctl is-active nginx)" == active ]] || fail
  [[ "$(systemctl is-enabled nginx)" == enabled ]] || fail
  wait_healthy || fail
  assert_private_listeners
  assert_permissions
  assert_images
  printf 'baseline=PASS\n'
  printf 'configuration_sha256=%s\n' "$(configuration_hash)"
}

assert_ingested() {
  local query
  query="{job=\"snsd-sanitized-validation\"} |= \"${validation_id}\""
  local attempt
  for attempt in $(seq 1 30); do
    if curl --get --fail --silent --max-time 8 \
      --data-urlencode "query=${query}" \
      http://127.0.0.1:3100/loki/api/v1/query_range | grep -Fq "${validation_id}"; then
      return 0
    fi
    sleep 2
  done
  return 1
}

assert_evidence_integrity() {
  python3 - "${input_file}" "${validation_id}" <<'PY'
import json
import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
expected_id = sys.argv[2]
lines = path.read_text(encoding="utf-8").splitlines()
if len(lines) != 1:
    raise SystemExit(1)
record = json.loads(lines[0])
if set(record) != {"timestamp", "event_type", "outcome", "sensitivity", "validation_id"}:
    raise SystemExit(1)
if record != {
    "timestamp": record["timestamp"],
    "event_type": "ZT_VIS_002_VALIDATION",
    "outcome": "PASS",
    "sensitivity": "SANITIZED",
    "validation_id": expected_id,
}:
    raise SystemExit(1)
if not re.fullmatch(r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z", record["timestamp"]):
    raise SystemExit(1)
forbidden = re.compile(
    r"BEGIN [A-Z ]*PRIVATE KEY|gh[pousr]_[A-Za-z0-9]{20,}|"
    r"(?i:password|secret|token|credential)\s*[:=]"
)
if forbidden.search(lines[0]):
    raise SystemExit(1)
PY
}

case "${mode}" in
  baseline)
    assert_baseline
    ;;
  positive)
    require_authorization
    validate_id
    assert_baseline
    printf '{"timestamp":"%s","event_type":"ZT_VIS_002_VALIDATION","outcome":"PASS","sensitivity":"SANITIZED","validation_id":"%s"}\n' \
      "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "${validation_id}" >"${input_file}"
    chmod 0640 "${input_file}"
    assert_ingested || fail
    printf 'positive=PASS\n'
    ;;
  bypass)
    assert_baseline
    private_address="$(awk '/^[[:space:]]*listen[[:space:]].*:443[[:space:]]+ssl;/{gsub(/;/,"",$2); sub(/:443$/,"",$2); print $2; exit}' "${nginx_site}")"
    ! curl --silent --max-time 3 "http://${private_address}:3000/api/health" >/dev/null 2>&1 || fail
    printf 'bypass=PASS\n'
    ;;
  evidence)
    validate_id
    [[ -f "${input_file}" ]] || fail
    assert_evidence_integrity || fail
    assert_ingested || fail
    printf 'evidence_integrity=PASS\n'
    ;;
  persistence|recovery)
    validate_id
    assert_baseline
    [[ -f "${input_file}" ]] || fail
    grep -Fq "${validation_id}" "${input_file}" || fail
    assert_ingested || fail
    printf '%s=PASS\n' "${mode}"
    ;;
  rollback)
    validate_id
    assert_mount
    [[ "$(podman ps -q | wc -l)" -eq 0 ]] || fail
    ! ss -lntH | awk '$4 ~ /:(3000|3100|12345|9090|9115)$/ {found=1} END {exit !found}' || fail
    [[ -f "${compose_file}" ]] || fail
    [[ -f "${root}/secrets/grafana_admin_password" ]] || fail
    [[ -f "${input_file}" ]] || fail
    grep -Fq "${validation_id}" "${input_file}" || fail
    printf 'rollback=PASS\n'
    printf 'configuration_sha256=%s\n' "$(configuration_hash)"
    ;;
  cleanup)
    require_authorization
    rm -f -- "${input_file}"
    [[ ! -e "${input_file}" ]] || fail
    printf 'cleanup=PASS\n'
    ;;
  *)
    fail
    ;;
esac
