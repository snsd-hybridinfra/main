{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlySyntheticBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::lab-synthetic-artifacts"
    },
    {
      "Sid": "ReadOnlySyntheticObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::lab-synthetic-artifacts/*"
    },
    {
      "Sid": "NoBucketWrites",
      "Effect": "Deny",
      "Action": ["s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::lab-synthetic-artifacts/*"
    }
  ]
}
