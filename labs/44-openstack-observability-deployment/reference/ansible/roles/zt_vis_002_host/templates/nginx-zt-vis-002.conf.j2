server {
    listen {{ zt_vis_002_proxy_bind_address }}:443 ssl;
    server_name {{ zt_vis_002_proxy_server_name }};

    ssl_certificate /etc/nginx/zt-vis-002/server.crt;
    ssl_certificate_key /etc/nginx/zt-vis-002/server.key;
    ssl_client_certificate /etc/nginx/zt-vis-002/client-ca.crt;
    ssl_verify_client on;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    access_log off;
    error_log /var/log/nginx/zt-vis-002-error.log warn;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
